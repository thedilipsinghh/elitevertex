NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/elitevertax
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Cloudinary (Optional - for media & certificates)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin seed defaults
ADMIN_USER=admin@elitevertax.com
ADMIN_PASS=password123

# Email config
EMAIL_FROM=noreply@elitevertax.com
EMAIL_PASS=your_email_password_or_app_password

# Frontend
FRONTEND_URL=http://localhost:3000
